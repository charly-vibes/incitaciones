{
  "name": "incitaciones",
  "version": "0.3.2",
  "description": "Reusable prompts and skills for CLI LLM tools, with native pi package support.",
  "repository": {
    "type": "git",
    "url": "git@github.com:charly-vibes/incitaciones.git"
  },
  "homepage": "https://github.com/charly-vibes/incitaciones",
  "bugs": {
    "url": "https://github.com/charly-vibes/incitaciones/issues"
  },
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "agent-skills",
    "prompts",
    "skills",
    "pi-cli"
  ],
  "bin": {
    "incitaciones": "./scripts/cli.mjs"
  },
  "files": [
    "content/distilled",
    "content/manifest.json",
    "pi-package/",
    "scripts/cli.mjs",
    "scripts/generate-pi-resources.mjs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prepare": "node scripts/generate-pi-resources.mjs",
    "prepare-pi": "node scripts/generate-pi-resources.mjs",
    "prepack": "node scripts/generate-pi-resources.mjs",
    "postinstall": "node scripts/generate-pi-resources.mjs"
  },
  "pi": {
    "skills": [
      "./pi-package/skills"
    ],
    "prompts": [
      "./pi-package/prompts"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
